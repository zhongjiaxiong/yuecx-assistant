<view class="page">
  <view class="form">
    <view class="field">
      <text class="label">姓名</text>
      <input
        class="input"
        placeholder="与证件一致"
        value="{{form.name}}"
        bindinput="onInput"
        data-key="name"
        maxlength="20"
      />
    </view>

    <view class="field">
      <text class="label">证件类型</text>
      <picker
        mode="selector"
        range="{{idTypeLabels}}"
        value="{{idTypeIndex}}"
        bindchange="onIdTypeChange"
      >
        <view class="picker-val">
          {{idTypeLabels[idTypeIndex]}}
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="field">
      <text class="label">证件号</text>
      <input
        class="input"
        placeholder="18 位身份证号"
        value="{{form.idNumber}}"
        bindinput="onInput"
        data-key="idNumber"
        maxlength="18"
      />
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        placeholder="可选"
        value="{{form.phone}}"
        bindinput="onInput"
        data-key="phone"
        maxlength="11"
      />
    </view>

    <view class="field row">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault}}" bindchange="onDefaultChange" color="#1677ff" />
    </view>
  </view>

  <button class="save-btn" bindtap="onSave" loading="{{saving}}">保存</button>
  <button class="delete-btn" wx:if="{{editingId}}" bindtap="onDelete">删除</button>
</view>
