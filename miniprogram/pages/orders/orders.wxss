.orders-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f5f5f5;
}

/* 筛选栏 */
.filter-bar {
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e8e8e8;
  flex-shrink: 0;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
}

.filter-item.active {
  background: #1677ff;
  color: #fff;
  border-color: #1677ff;
}

/* 统计 */
.stats-bar {
  padding: 12rpx 24rpx;
  flex-shrink: 0;
}

.stats-text {
  font-size: 24rpx;
  color: #999;
}

/* 加载 */
.loading-tip {
  text-align: center;
  padding: 80rpx;
  font-size: 28rpx;
  color: #999;
}

/* 空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.empty-action {
  padding: 16rpx 48rpx;
  background: #1677ff;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 订单列表 */
.order-list {
  flex: 1;
  height: 0;
  padding: 16rpx 24rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-id {
  font-size: 22rpx;
  color: #999;
}

.order-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-pending { background: #fff7e6; color: #fa8c16; }
.status-paid { background: #e6f7ff; color: #1890ff; }
.status-completed { background: #f6ffed; color: #52c41a; }
.status-cancelled { background: #f5f5f5; color: #999; }
.status-confirmed { background: #e6f7ff; color: #1890ff; }

.order-route {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.detail-rows {
  margin-bottom: 16rpx;
}

.detail-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.detail-label {
  color: #999;
  min-width: 80rpx;
  flex-shrink: 0;
}

.detail-value {
  color: #333;
}

.detail-value.price {
  color: #ff4d4f;
  font-weight: 600;
}

.card-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  flex: 1;
  padding: 14rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
  background: #fff;
  color: #666;
}

.action-btn.primary {
  background: #1677ff;
  color: #fff;
  border-color: #1677ff;
}

.action-btn.danger {
  color: #ff4d4f;
  border-color: #ff4d4f;
}
