<view class="orders-page">
  <!-- 筛选栏 -->
  <scroll-view scroll-x class="filter-bar">
    <view
      class="filter-item {{currentFilter === '' ? 'active' : ''}}"
      bindtap="onFilter"
      data-status=""
    >全部</view>
    <view
      class="filter-item {{currentFilter === 'pending' ? 'active' : ''}}"
      bindtap="onFilter"
      data-status="pending"
    >待支付</view>
    <view
      class="filter-item {{currentFilter === 'paid' ? 'active' : ''}}"
      bindtap="onFilter"
      data-status="paid"
    >已支付</view>
    <view
      class="filter-item {{currentFilter === 'completed' ? 'active' : ''}}"
      bindtap="onFilter"
      data-status="completed"
    >已完成</view>
    <view
      class="filter-item {{currentFilter === 'cancelled' ? 'active' : ''}}"
      bindtap="onFilter"
      data-status="cancelled"
    >已取消</view>
  </scroll-view>

  <!-- 统计 -->
  <view class="stats-bar" wx:if="{{total > 0}}">
    <text class="stats-text">共 {{total}} 单</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-tip" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空态 -->
  <view class="empty-state" wx:elif="{{!orders.length && !loading}}">
    <text class="empty-icon">🎫</text>
    <text class="empty-text">暂无订单</text>
    <view class="empty-action" bindtap="goChat">去查询班次</view>
  </view>

  <!-- 订单列表 -->
  <scroll-view scroll-y class="order-list" wx:else>
    <view class="order-card" wx:for="{{orders}}" wx:key="orderId">
      <!-- 头部 -->
      <view class="card-header">
        <text class="order-id">{{item.orderId}}</text>
        <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <!-- 路线 -->
      <text class="order-route">{{item.route}}</text>

      <!-- 详情 -->
      <view class="detail-rows">
        <view class="detail-row">
          <text class="detail-label">日期</text>
          <text class="detail-value">{{item.date}} {{item.fromTime}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">上下车</text>
          <text class="detail-value">{{item.boardingStation || '未指定'}} → {{item.dropoffStation || '未指定'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">票价</text>
          <text class="detail-value price">¥{{item.priceYuan}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">来源</text>
          <text class="detail-value">{{item.sourceName}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="card-actions">
        <view
          class="action-btn primary"
          wx:if="{{item.status === 'pending'}}"
          bindtap="onPay"
          data-order="{{item}}"
        >去购票</view>
        <view
          class="action-btn danger"
          wx:if="{{item.status === 'pending'}}"
          bindtap="onCancel"
          data-id="{{item.orderId}}"
        >取消</view>
        <view
          class="action-btn"
          bindtap="onDetail"
          data-id="{{item.orderId}}"
        >详情</view>
      </view>
    </view>
  </scroll-view>
</view>
