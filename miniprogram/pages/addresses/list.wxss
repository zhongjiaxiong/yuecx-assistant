.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 24rpx 160rpx;
}

.list { background: #fff; border-radius: 16rpx; overflow: hidden; }

.item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}
.item:last-child { border-bottom: none; }

.tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.tag-home { background: #fff7e6; color: #fa8c16; }
.tag-company { background: #e6f4ff; color: #1677ff; }
.tag-other { background: #f5f5f5; color: #666; }

.main { flex: 1; min-width: 0; }
.city { font-size: 28rpx; color: #222; font-weight: 500; }
.detail {
  font-size: 24rpx; color: #999; margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.arrow { font-size: 40rpx; color: #ccc; }

.empty {
  text-align: center; padding: 120rpx 0 40rpx; color: #999;
  font-size: 28rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 30rpx; color: #666; }
.empty-sub { font-size: 24rpx; color: #bbb; margin-top: 8rpx; }

.add-btn {
  position: fixed; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding: 24rpx 0; text-align: center; background: #1677ff; color: #fff;
  border-radius: 12rpx; font-size: 30rpx; font-weight: 500;
}
