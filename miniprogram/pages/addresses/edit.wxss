.page { min-height: 100vh; background: #f5f5f5; padding: 24rpx; }

.form { background: #fff; border-radius: 16rpx; overflow: hidden; }

.field {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.field:last-child { border-bottom: none; }

.label { width: 160rpx; font-size: 28rpx; color: #666; flex-shrink: 0; }
.input { flex: 1; font-size: 28rpx; color: #222; }

.picker-val, .coord-val {
  flex: 1; font-size: 28rpx; color: #222;
  display: flex; align-items: center; justify-content: space-between;
}
.picker-arrow { color: #ccc; font-size: 32rpx; }
.coord-text { font-family: monospace; font-size: 26rpx; color: #1677ff; }
.coord-placeholder { color: #bbb; font-size: 28rpx; }

.save-btn {
  margin-top: 48rpx; background: #1677ff; color: #fff;
  border-radius: 12rpx; font-size: 30rpx; padding: 24rpx 0; font-weight: 500;
}
.save-btn::after { border: none; }

.delete-btn {
  margin-top: 24rpx; background: #fff; color: #ff4d4f;
  border-radius: 12rpx; font-size: 30rpx; padding: 24rpx 0;
}
.delete-btn::after { border: none; }
