.chat-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #f5f5f5;
}

/* 手机号登录栏 */
.login-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #e6f4ff;
  border-bottom: 1rpx solid #bae0ff;
  flex-shrink: 0;
}

.login-text {
  font-size: 24rpx;
  color: #0958d9;
  flex: 1;
}

.login-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 48rpx;
  line-height: 48rpx;
  font-size: 24rpx;
  color: #fff;
  background: #1677ff;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.login-btn::after {
  border: none;
}

/* 定位提示栏 */
.location-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fffbe6;
  border-bottom: 1rpx solid #ffe58f;
  flex-shrink: 0;
}

.location-text {
  font-size: 24rpx;
  color: #ad8b00;
}

.location-btn {
  font-size: 24rpx;
  color: #1677ff;
  padding: 6rpx 20rpx;
  border: 1rpx solid #1677ff;
  border-radius: 20rpx;
}

/* 欢迎提示横幅 */
.welcome-hint {
  text-align: center;
  padding: 16rpx 0 8rpx;
  font-size: 22rpx;
  color: #999;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 20rpx 24rpx;
  height: 0;
}

.message {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.message.user {
  justify-content: flex-end;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.assistant-avatar {
  background: linear-gradient(135deg, #1677ff, #4096ff);
  color: #fff;
  margin-right: 16rpx;
}

.user-avatar {
  background: #e6e6e6;
  color: #666;
  margin-left: 16rpx;
}

.bubble-wrap {
  max-width: 80%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bubble {
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  max-width: 80%;
}

.message.user .bubble,
.user-bubble {
  background: #1677ff;
  color: #fff;
  max-width: none;
}

.message.assistant .bubble {
  max-width: none;
}

/* loading */
.loading-bubble {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #1677ff;
  animation: dotBounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
.dot:nth-child(3) { animation-delay: 0s; }

@keyframes dotBounce {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1); }
}

.loading-text {
  font-size: 24rpx;
  color: #999;
}

/* 输入区 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 14rpx 28rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  background: #e8e8e8;
  color: #999;
  flex-shrink: 0;
}

.send-btn.active {
  background: #1677ff;
  color: #fff;
}

/* 语音/键盘切换 */
.mode-toggle {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.toggle-icon {
  width: 48rpx;
  height: 48rpx;
}

.voice-btn {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.voice-btn.recording {
  background: #e0e0e0;
}

.map-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* 录音遮罩 */
.record-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.record-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
}

.wave-bar {
  width: 8rpx;
  height: 40rpx;
  border-radius: 4rpx;
  background: #1677ff;
  animation: waveAnim 0.8s ease-in-out infinite alternate;
}

.wave-bar:nth-child(1) { height: 24rpx; animation-delay: 0s; }
.wave-bar:nth-child(2) { height: 40rpx; animation-delay: 0.1s; }
.wave-bar:nth-child(3) { height: 64rpx; animation-delay: 0.2s; }
.wave-bar:nth-child(4) { height: 48rpx; animation-delay: 0.3s; }
.wave-bar:nth-child(5) { height: 32rpx; animation-delay: 0.4s; }

@keyframes waveAnim {
  from { transform: scaleY(0.4); }
  to { transform: scaleY(1); }
}

.record-tip {
  color: #fff;
  font-size: 28rpx;
}

/* 进度条 */
.step-bar {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 8rpx 0;
}

.step-item {
  display: flex;
  align-items: center;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #bbb;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.step-dot.active {
  background: #1677ff;
  color: #fff;
  animation: stepPulse 1.2s ease-in-out infinite;
}

.step-dot.done {
  background: #52c41a;
  color: #fff;
}

.step-label {
  font-size: 22rpx;
  color: #bbb;
  margin-left: 4rpx;
  white-space: nowrap;
}

.step-label.active { color: #1677ff; font-weight: 600; }
.step-label.done { color: #999; }

.step-line {
  width: 24rpx;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 4rpx;
  flex-shrink: 0;
}

.step-line.done { background: #52c41a; }

@keyframes stepPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(22, 119, 255, 0.4); }
  50% { box-shadow: 0 0 0 8rpx rgba(22, 119, 255, 0); }
}
