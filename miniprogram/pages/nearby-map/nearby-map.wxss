.map-page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.map-view {
  width: 100%;
  height: 55%;
  flex-shrink: 0;
}

.station-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-top: 1rpx solid #e8e8e8;
  overflow: hidden;
}

.panel-header {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.panel-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 60rpx;
  font-size: 26rpx;
  color: #999;
}

.station-list {
  flex: 1;
  height: 0;
}

.station-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 16rpx;
}

.station-item:active {
  background: #f9f9f9;
}

.station-rank {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #1677ff;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.station-info {
  flex: 1;
  min-width: 0;
}

.station-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.station-meta {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.station-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #1677ff;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.select-btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid #1677ff;
  border-radius: 28rpx;
  background: #fff;
  color: #1677ff;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.select-btn:active {
  background: #1677ff;
  color: #fff;
}
